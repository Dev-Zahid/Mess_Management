# Supabase Postgres connection string.
#
# ⚠️ CRITICAL: use the "Transaction" pooler connection string (port 6543),
# NOT "Session" mode (port 5432). Session mode hard-caps concurrent
# connections at 15 (Supabase free tier) — on Vercel, many serverless
# function instances can run at once, each holding its own connection,
# so Session mode WILL eventually fail with:
#   "FATAL: (EMAXCONNSESSION) max clients reached in session mode"
# Get the correct one from: Supabase → Project Settings → Database →
# Connection string → "Transaction" tab (not "Session").
# It must include `?pgbouncer=true` at the end, like this:
DATABASE_URL="postgresql://postgres.[project-ref]:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Only used when running `npm run db:push` / migrations (not by the app
# at runtime) — this is the DIRECT connection (port 5432, no pgbouncer),
# because schema changes (DDL) don't work reliably through the pooler.
# Get it from: Supabase → Project Settings → Database → Connection string
# → "Session" tab, OR the plain "URI" shown at the top of that page.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Any long random string — used to sign login sessions
JWT_SECRET="change-this-to-a-long-random-string"

# Used only once by `npm run db:seed` to create your Super Admin login
SUPERADMIN_PHONE="01700000000"
SUPERADMIN_PIN="123456"
